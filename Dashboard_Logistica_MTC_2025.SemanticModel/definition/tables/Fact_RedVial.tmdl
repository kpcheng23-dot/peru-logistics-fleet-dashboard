table Fact_RedVial
	lineageTag: 4f33b8fc-4ddd-40db-baac-c6757641770c

	measure 'Longitud vial (km)' = VAR AnioEvaluado = MAX('Dim_Año'[Año]) RETURN CALCULATE(SUM(Fact_RedVial[LongitudTotalKm]), KEEPFILTERS('Dim_Año'[Año] = AnioEvaluado))
		formatString: #,0.0
		lineageTag: 31a8748a-4f31-4211-a952-19ce4d735b49
		dataCategory: Uncategorized

	measure 'Km red nacional' =
			
			VAR AnioEvaluado = MAX('Dim_Año'[Año])
			RETURN
			    CALCULATE(
			        SUM(Fact_RedVial[NacionalTotalKm]),
			        KEEPFILTERS('Dim_Año'[Año] = AnioEvaluado)
			    )
		formatString: #,0.0
		lineageTag: 3469bda0-8db6-4ec9-9e9b-e6310672f42a

	measure 'Km red departamental' =
			
			VAR AnioEvaluado = MAX('Dim_Año'[Año])
			RETURN
			    CALCULATE(
			        SUM(Fact_RedVial[DepartamentalTotalKm]),
			        KEEPFILTERS('Dim_Año'[Año] = AnioEvaluado)
			    )
		formatString: #,0.0
		lineageTag: af8e2543-ad66-41d1-a67a-84210e3eda3f

	measure 'Km red vecinal' =
			
			VAR AnioEvaluado = MAX('Dim_Año'[Año])
			RETURN
			    CALCULATE(
			        SUM(Fact_RedVial[VecinalTotalKm]),
			        KEEPFILTERS('Dim_Año'[Año] = AnioEvaluado)
			    )
		formatString: #,0.0
		lineageTag: 8a9280ab-5978-438e-9048-e6c1db83a537

	measure 'Longitud total mostrada' =
			
			VAR ValorKm = [Longitud vial (km)]
			RETURN
			    IF(
			        ISBLANK(ValorKm),
			        BLANK(),
			        FORMAT(ValorKm, "#,##0.0", "es-PE") & " km"
			    )
		lineageTag: 2f551698-e9bf-421b-a8fd-4ebdfb651544

	measure 'Red nacional mostrada' =
			
			VAR ValorKm = [Km red nacional]
			VAR Participacion = DIVIDE(ValorKm, [Longitud vial (km)])
			RETURN
			    IF(
			        ISBLANK(ValorKm),
			        BLANK(),
			        "km · " & FORMAT(Participacion, "0.0%", "es-PE")
			    )
		lineageTag: 70f4f299-a33e-4e2d-95ff-b7338a7e2bf9

	measure 'Red departamental mostrada' =
			
			VAR ValorKm = [Km red departamental]
			VAR Participacion = DIVIDE(ValorKm, [Longitud vial (km)])
			RETURN IF(ISBLANK(ValorKm),
			        BLANK(),
			        "km · " & FORMAT(Participacion, "0.0%", "es-PE")
			    )
		lineageTag: 381c0d40-319a-4288-a06a-50c1efe66624

	measure 'Red vecinal mostrada' =
			
			VAR ValorKm = [Km red vecinal]
			VAR Participacion = DIVIDE(ValorKm, [Longitud vial (km)])
			RETURN
			    IF(
			        ISBLANK(ValorKm),
			        BLANK(),
			        "km · " & FORMAT(Participacion, "0.0%", "es-PE")
			    )
		lineageTag: 5c2b0692-890c-46d7-9b93-24aa26171394

	measure 'Km pavimentados' =
			
			VAR AnioEvaluado = MAX('Dim_Año'[Año])
			RETURN
			    CALCULATE(
			        SUM(Fact_RedVial[NacionalPavimentadaKm])
			        + SUM(Fact_RedVial[DepartamentalPavimentadaKm])
			        + SUM(Fact_RedVial[VecinalPavimentadaKm]),
			        KEEPFILTERS('Dim_Año'[Año] = AnioEvaluado)
			    )
		lineageTag: 0305dfa6-0761-4837-9ad2-3b639b8d2fdc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Porcentaje pavimentado' =
			
			DIVIDE([Km pavimentados], [Longitud vial (km)])
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 567d318e-3bd0-450d-bc6a-bdad568bd848

	measure 'Fondo hasta 35 %' =
			
			VAR P = [Porcentaje pavimentado]
			RETURN IF(ISBLANK(P), BLANK(), MAX(0, 0.35 - P))
		lineageTag: b68c62d4-e24e-4755-96f9-bd2b12f5e7d5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Km pavimentada por red' =
			
			VAR Anio = MAX('Dim_Año'[Año])
			RETURN
			CALCULATE(
			    SWITCH(
			        SELECTEDVALUE(TipoRed[Red]),
			        "Red Nacional", SUM(Fact_RedVial[NacionalPavimentadaKm]),
			        "Departamental", SUM(Fact_RedVial[DepartamentalPavimentadaKm]),
			        "Red Vecinal", SUM(Fact_RedVial[VecinalPavimentadaKm])
			    ),
			    KEEPFILTERS('Dim_Año'[Año] = Anio)
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: cd6352b2-d533-4a1d-b736-109c5da24fb3

	measure 'Km no pavimentada por red' =
			
			VAR Anio = MAX('Dim_Año'[Año])
			RETURN
			CALCULATE(
			    SWITCH(
			        SELECTEDVALUE(TipoRed[Red]),
			        "Red Nacional", SUM(Fact_RedVial[NacionalNoPavimentadaKm]),
			        "Departamental", SUM(Fact_RedVial[DepartamentalNoPavimentadaKm]),
			        "Red Vecinal", SUM(Fact_RedVial[VecinalNoPavimentadaKm])
			    ),
			    KEEPFILTERS('Dim_Año'[Año] = Anio)
			)
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 46f5ef0f-8fd6-487b-b4fa-8b8553119a15

	measure '% pavimentada por red' =
			
			DIVIDE(
			    [Km pavimentada por red],
			    [Km pavimentada por red] + [Km no pavimentada por red]
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: ef924647-3cfc-4cd9-9028-57416b12092a

