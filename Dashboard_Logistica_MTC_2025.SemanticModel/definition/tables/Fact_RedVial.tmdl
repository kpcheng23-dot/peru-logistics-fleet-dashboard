	partition Fact_RedVial = m
		mode: import
		source = ```
				let
				    Normalizar = (valor as any) as text =>
				        let
				            texto = 
				            if valor = null then
				            ""
				            else
				            try Text.From(valor) otherwise "",
				            limpio = Text.Trim(Text.Clean(texto))
				        in
				            Text.Upper(limpio),
				
				    VariantesDepartamento = {
				        "AMAZONAS",
				        "ANCASH", "ÁNCASH",
				        "APURIMAC", "APURÍMAC",
				        "AREQUIPA",
				        "AYACUCHO",
				        "CAJAMARCA",
				        "CALLAO",
				        "CUSCO", "CUZCO",
				        "HUANCAVELICA",
				        "HUANUCO", "HUÁNUCO",
				        "ICA",
				        "JUNIN", "JUNÍN",
				        "LA LIBERTAD",
				        "LAMBAYEQUE",
				        "LIMA",
				        "LORETO",
				        "MADRE DE DIOS",
				        "MOQUEGUA",
				        "PASCO",
				        "PIURA",
				        "PUNO",
				        "SAN MARTIN", "SAN MARTÍN",
				        "TACNA",
				        "TUMBES",
				        "UCAYALI"
				    },
				
				    DepartamentosCanonicos = {
				        "Amazonas",
				        "Áncash", "Áncash",
				        "Apurímac", "Apurímac",
				        "Arequipa",
				        "Ayacucho",
				        "Cajamarca",
				        "Callao",
				        "Cusco", "Cusco",
				        "Huancavelica",
				        "Huánuco", "Huánuco",
				        "Ica",
				        "Junín", "Junín",
				        "La Libertad",
				        "Lambayeque",
				        "Lima",
				        "Loreto",
				        "Madre de Dios",
				        "Moquegua",
				        "Pasco",
				        "Piura",
				        "Puno",
				        "San Martín", "San Martín",
				        "Tacna",
				        "Tumbes",
				        "Ucayali"
				    },
				
				    MapaDepartamentos =
				        Record.FromList(
				            DepartamentosCanonicos,
				            VariantesDepartamento
				        ),
				
				    DepartamentoCanonico = (valor as any) as nullable text =>
				        Record.FieldOrDefault(
				            MapaDepartamentos,
				            Normalizar(valor),
				            null
				        ),
				
				    BuscarEncabezado = (lista as list, inicio as text) as number =>
				        List.PositionOf(
				            List.Transform(lista, each Text.StartsWith(_, inicio)),
				            true
				        ),
				
				    ObtenerValor = (lista as list, posicion as number) as any =>
				        try lista{posicion} otherwise null,
				
				    ConvertirNumero = (valor as any) as nullable number =>
				        try Number.From(valor) otherwise null,
				
				    TransformarHoja = (tabla as table, anio as number) as table =>
				        let
				            Columnas = Table.ColumnNames(tabla),
				
				            ConIndice =
				                Table.AddIndexColumn(
				                    tabla,
				                    "__Fila",
				                    0,
				                    1,
				                    Int64.Type
				                ),
				
				            Candidatos =
				                List.Combine(
				                    List.Transform(
				                        Table.ToRecords(ConIndice),
				                        (fila as record) =>
				                            let
				                                ValoresFila =
				                                    List.Transform(
				                                        Columnas,
				                                        (columna as text) =>
				                                            Normalizar(
				                                                Record.Field(fila, columna)
				                                            )
				                                    ),
				
				                                PosicionesDepartamento =
				                                    List.PositionOf(
				                                        ValoresFila,
				                                        "DEPARTAMENTO",
				                                        Occurrence.All
				                                    ),
				
				                                Evaluados =
				                                    List.Transform(
				                                        PosicionesDepartamento,
				                                        (posicion as number) =>
				                                            let
				                                                Siguientes =
				                                                    List.Select(
				                                                        PosicionesDepartamento,
				                                                        each _ > posicion
				                                                    ),
				
				                                                Limite =
				                                                    if List.Count(Siguientes) > 0
				                                                    then List.Min(Siguientes)
				                                                    else List.Count(ValoresFila),
				
				                                                Segmento =
				                                                    List.Range(
				                                                        ValoresFila,
				                                                        posicion,
				                                                        Limite - posicion
				                                                    ),
				
				                                                EsValido =
				                                                    BuscarEncabezado(Segmento, "LONGITUD") >= 0
				                                                        and BuscarEncabezado(Segmento, "NACIONAL") >= 0
				                                                        and BuscarEncabezado(Segmento, "DEPARTAMENTAL") >= 0
				                                                        and BuscarEncabezado(Segmento, "VECINAL") >= 0
				                                            in
				                                                if EsValido then
				                                                    [
				                                                        Fila = Record.Field(fila, "__Fila"),
				                                                        PosDepartamento = posicion,
				                                                        Segmento = Segmento
				                                                    ]
				                                                else
				                                                    null
				                                    )
				                            in
				                                List.RemoveNulls(Evaluados)
				                    )
				                ),
				
				            UltimaFila =
				                List.Max(
				                    List.Transform(Candidatos, each [Fila])
				                ),
				
				            CandidatosUltimaFila =
				                List.Select(
				                    Candidatos,
				                    each [Fila] = UltimaFila
				                ),
				
				            EncabezadoElegido =
				                List.Last(CandidatosUltimaFila),
				
				            PosDepartamento =
				                EncabezadoElegido[PosDepartamento],
				
				            SegmentoElegido =
				                EncabezadoElegido[Segmento],
				
				            PosLongitud =
				                PosDepartamento
				                    + BuscarEncabezado(SegmentoElegido, "LONGITUD"),
				
				            PosNacional =
				                PosDepartamento
				                    + BuscarEncabezado(SegmentoElegido, "NACIONAL"),
				
				            PosDepartamental =
				                PosDepartamento
				                    + BuscarEncabezado(SegmentoElegido, "DEPARTAMENTAL"),
				
				            PosVecinal =
				                PosDepartamento
				                    + BuscarEncabezado(SegmentoElegido, "VECINAL"),
				
				            FilasDeDatos =
				                Table.Skip(
				                    tabla,
				                    EncabezadoElegido[Fila] + 3
				                ),
				
				            Registros =
				                List.Transform(
				                    Table.ToRecords(FilasDeDatos),
				                    (fila as record) =>
				                        let
				                            Valores =
				                                Record.FieldValues(
				                                    Record.SelectFields(fila, Columnas)
				                                ),
				
				                            Departamento =
				                                DepartamentoCanonico(
				                                    ObtenerValor(
				                                        Valores,
				                                        PosDepartamento
				                                    )
				                                )
				                        in
				                            [
				                                DEPARTAMENTO = Departamento,
				                                #"Año" = anio,
				                                LongitudTotalKm =
				                                    ConvertirNumero(
				                                        ObtenerValor(Valores, PosLongitud)
				                                    ),
				                                NacionalTotalKm =
				                                    ConvertirNumero(
				                                        ObtenerValor(Valores, PosNacional)
				                                    ),
				                                NacionalPavimentadaKm =
				                                    ConvertirNumero(
				                                        ObtenerValor(Valores, PosNacional + 1)
				                                    ),
				                                NacionalNoPavimentadaKm =
				                                    ConvertirNumero(
				                                        ObtenerValor(Valores, PosNacional + 2)
				                                    ),
				                                DepartamentalTotalKm =
				                                    ConvertirNumero(
				                                        ObtenerValor(Valores, PosDepartamental)
				                                    ),
				                                DepartamentalPavimentadaKm =
				                                    ConvertirNumero(
				                                        ObtenerValor(Valores, PosDepartamental + 1)
				                                    ),
				                                DepartamentalNoPavimentadaKm =
				                                    ConvertirNumero(
				                                        ObtenerValor(Valores, PosDepartamental + 2)
				                                    ),
				                                VecinalTotalKm =
				                                    ConvertirNumero(
				                                        ObtenerValor(Valores, PosVecinal)
				                                    ),
				                                VecinalPavimentadaKm =
				                                    ConvertirNumero(
				                                        ObtenerValor(Valores, PosVecinal + 1)
				                                    ),
				                                VecinalNoPavimentadaKm =
				                                    ConvertirNumero(
				                                        ObtenerValor(Valores, PosVecinal + 2)
				                                    )
				                            ]
				                ),
				
				            RegistrosValidos =
				                List.Select(
				                    Registros,
				                    each
				                        [DEPARTAMENTO] <> null
				                            and [LongitudTotalKm] <> null
				                ),
				
				            Resultado =
				                Table.FromRecords(
				                    RegistrosValidos,
				                    type table [
				                        DEPARTAMENTO = text,
				                        #"Año" = Int64.Type,
				                        LongitudTotalKm = number,
				                        NacionalTotalKm = number,
				                        NacionalPavimentadaKm = number,
				                        NacionalNoPavimentadaKm = number,
				                        DepartamentalTotalKm = number,
				                        DepartamentalPavimentadaKm = number,
				                        DepartamentalNoPavimentadaKm = number,
				                        VecinalTotalKm = number,
				                        VecinalPavimentadaKm = number,
				                        VecinalNoPavimentadaKm = number
				                    ]
				                )
				        in
				            Resultado,
				
				    Libro =
				        Excel.Workbook(
				            Web.Contents(pURL_RedVial),
				            null,
				            true
				        ),
				
				    SoloHojas =
				        Table.SelectRows(
				            Libro,
				            each [Kind] = "Sheet"
				        ),
				
				    ConAño =
				        Table.AddColumn(
				            SoloHojas,
				            "AñoHoja",
				            each
				                try Number.FromText(
				                    Text.Trim(Text.From([Item]))
				                )
				                otherwise null,
				            Int64.Type
				        ),
				
				    HojasAnuales =
				        Table.SelectRows(
				            ConAño,
				            each
				                [AñoHoja] <> null
				                    and [AñoHoja] >= 2010
				                    and [AñoHoja] <= 2025
				                    and [Item] <> "2023"
				        ),
				
				    TablasTransformadas =
				        List.Transform(
				            Table.ToRecords(HojasAnuales),
				            each TransformarHoja([Data], [AñoHoja])
				        ),
				
				    DatosCombinados =
				        Table.Combine(TablasTransformadas),
				
				    SinDuplicados =
				        Table.Distinct(
				            DatosCombinados,
				            {"Año", "DEPARTAMENTO"}
				        )
				in
				    SinDuplicados
				```

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

