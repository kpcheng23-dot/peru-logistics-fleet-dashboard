	column 'Clase de vehículo agrupada' =
			
			VAR Clase =
			    UPPER(
			        TRIM(Fact_Flota_2025[Clase de vehículo])
			    )
			RETURN
			    SWITCH(
			        TRUE(),
			        Clase = "CAMION", "Camión",
			        Clase = "SEMIREMOLQUE", "Semirremolque",
			        Clase = "REMOLCADOR", "Remolcador",
			        Clase = "CMTA PICKUP", "Cta. Pickup",
			        "Otros"
			    )
		lineageTag: 9eb18653-c5ad-4415-96c4-5fbf09efd005
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Grupo antigüedad' =
			
			VAR AnioFab = Fact_Flota_2025[AÑO_FAB]
			VAR FechaCorte = Fact_Flota_2025[FECHA_CORTE]
			VAR Edad = YEAR(FechaCorte) - AnioFab
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(AnioFab) || ISBLANK(FechaCorte) || AnioFab < 1900 || Edad < 0, "Año no válido",
			        Edad <= 5, "0–5 años",
			        Edad <= 10, "6–10 años",
			        Edad <= 15, "11–15 años",
			        Edad <= 20, "16–20 años",
			        "Más de 20 años"
			    )
		lineageTag: 9bf879fb-d085-448b-93a8-e36434bb59d2
		summarizeBy: none
		sortByColumn: 'Orden antigüedad'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Orden antigüedad' =
			
			VAR AnioFab = Fact_Flota_2025[AÑO_FAB]
			VAR FechaCorte = Fact_Flota_2025[FECHA_CORTE]
			VAR Edad = YEAR(FechaCorte) - AnioFab
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(AnioFab) || ISBLANK(FechaCorte) || AnioFab < 1900 || Edad < 0, 6,
			        Edad <= 5, 1,
			        Edad <= 10, 2,
			        Edad <= 15, 3,
			        Edad <= 20, 4,
			        5
			    )
		formatString: #,0
		lineageTag: 2489b2f6-736a-49db-bd69-6139228e146b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Combustible (grupos)' =
			SWITCH(
				TRUE,
				ISBLANK('Fact_Flota_2025'[Combustible]),
				"(En blanco)",
				'Fact_Flota_2025'[Combustible] IN {"BIODIESEL",
					"DIÉSEL",
					"HIBRIDO (DIESEL / BATERIAS)"},
				"DIÉSEL",
				'Fact_Flota_2025'[Combustible] IN {"CELDAS DE COMBUSTIBLE",
					"ELÉCTRICO"},
				"ELÉCTRICO",
				'Fact_Flota_2025'[Combustible] IN {"FLEXFUEL",
					"GASOLINA",
					"HÍBRIDO (GASOLINA / BATERIAS)"},
				"GASOLINA",
				'Fact_Flota_2025'[Combustible] IN {"BI - COMBUSTIBLE GLP",
					"GLP"},
				"GLP",
				'Fact_Flota_2025'[Combustible] IN {"BI - COMBUSTIBLE GNL",
					"BI - COMBUSTIBLE GNV",
					"GNL",
					"GNV"},
				"GNV",
				'Fact_Flota_2025'[Combustible] IN {"S/C"},
				"S/C",
				'Fact_Flota_2025'[Combustible]
			)
		lineageTag: dde48a10-76dc-46cb-b9bb-7b24ccf1cc79
		summarizeBy: none

