				    #"Personalizada agregada" = Table.AddColumn(#"Columnas con nombre cambiado", "FechaCorte", each #date(
				    Number.FromText(Text.Start(Text.From([FECHA_CORTE]), 4)),
				    Number.FromText(Text.Middle(Text.From([FECHA_CORTE]), 4, 2)),
				    Number.FromText(Text.End(Text.From([FECHA_CORTE]), 2))
				)),
				    #"Tipo cambiado1" = Table.TransformColumnTypes(#"Personalizada agregada",{{"FechaCorte", type date}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado1",{"FECHA_CORTE"}),
				    #"Columnas con nombre cambiado1" = Table.RenameColumns(#"Columnas quitadas",{{"FechaCorte", "FECHA_CORTE"}}),
