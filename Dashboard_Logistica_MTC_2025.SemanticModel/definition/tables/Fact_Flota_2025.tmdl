				    #"Personalizada agregada1" = Table.AddColumn(#"Tipo cambiado con configuración regional1", "Año", each Date.Year([FECHA_CORTE])),
				    #"Poner En Mayúsculas Cada Palabra" = Table.TransformColumns(#"Personalizada agregada1",{{"DEPARTAMENTO", Text.Proper, type text}}),
				    #"Personalizada agregada2" = Table.AddColumn(#"Poner En Mayúsculas Cada Palabra", "DEPARTAMENTO1", each if [DEPARTAMENTO] = "Ancash" then "Áncash"
				else if [DEPARTAMENTO] = "Apurimac" then "Apurímac"
				else if [DEPARTAMENTO] = "Huanuco" then "Huánuco"
				else if [DEPARTAMENTO] = "Junin" then "Junín"
				else if [DEPARTAMENTO] = "San Martin" then "San Martín"
				else if [DEPARTAMENTO] = "Madre De Dios" then "Madre de Dios"
				else [DEPARTAMENTO]),
				    #"Columnas reordenadas" = Table.ReorderColumns(#"Personalizada agregada2",{"ID", "RUC", "RAZON_SOCIAL", "FECHA_RESOLUCION", "VIGENCIA_HASTA", "PERMISO_OPER", "PLACA", "AÑO_FAB", "N_CHASIS", "N_MOTOR", "MARCA", "SERVICIO", "CLASE", "COMBUSTIBLE", "N_ASIENTOS", "N_LLANTAS", "N_EJES", "CARGA_UTIL", "P_SECO", "P_BRUTO", "LARGO", "ANCHO", "ALTO", "DEPARTAMENTO", "DEPARTAMENTO1", "FECHA_CORTE", "Año"}),
				    #"Columnas quitadas1" = Table.RemoveColumns(#"Columnas reordenadas",{"DEPARTAMENTO"}),
				    #"Columnas con nombre cambiado2" = Table.RenameColumns(#"Columnas quitadas1",{{"DEPARTAMENTO1", "DEPARTAMENTO"}}),
				    #"Tipo cambiado2" = Table.TransformColumnTypes(#"Columnas con nombre cambiado2",{{"DEPARTAMENTO", type text}, {"Año", Int64.Type}}),
				    #"Filas ordenadas" = Table.Sort(#"Tipo cambiado2", {{"FECHA_RESOLUCION", Order.Descending}}),
				    Personalizado1 = Table.Buffer(#"Filas ordenadas"),
