table Fact_Flota_2025
	lineageTag: 461c4a70-41f5-4321-b2ca-bb0877727a3a

	measure 'Registros de flota' = COUNTROWS(Fact_Flota_2025)
		formatString: 0
		lineageTag: 9fbd5f23-e165-4cc0-8319-120062ba2967

	measure 'Vehículos únicos' = DISTINCTCOUNT(Fact_Flota_2025[PLACA])
		formatString: #,0
		lineageTag: 733fa799-00dc-474b-9b08-c432f2b6b764

	measure 'Antigüedad promedio' = AVERAGEX(FILTER(Fact_Flota_2025, NOT(ISBLANK(Fact_Flota_2025[AÑO_FAB])) && Fact_Flota_2025[AÑO_FAB] >= 1900 && Fact_Flota_2025[AÑO_FAB] <= YEAR(Fact_Flota_2025[FECHA_CORTE])), YEAR(Fact_Flota_2025[FECHA_CORTE]) - Fact_Flota_2025[AÑO_FAB])
		formatString: 0.0
		lineageTag: 5ecdb8b1-7e34-4b41-9d08-77ef67dd26ae

	measure 'Vehículos flota' =
			
			COUNTROWS(Fact_Flota_2025)
		formatString: #,0
		lineageTag: 92d4680e-2d5c-40de-b5b9-a2b16c4c5f53

	measure '% Flota menor de 10 años' =
			
			VAR VehiculosConAnioValido =
			    CALCULATE(
			        [Vehículos únicos],
			        FILTER(
			            Fact_Flota_2025,
			            NOT ISBLANK(Fact_Flota_2025[AÑO_FAB]) &&
			            Fact_Flota_2025[AÑO_FAB] >= 1900 &&
			            Fact_Flota_2025[AÑO_FAB] <=
			                YEAR(Fact_Flota_2025[FECHA_CORTE])
			        )
			    )
			VAR VehiculosMenor10 =
			    CALCULATE(
			        [Vehículos únicos],
			        FILTER(
			            Fact_Flota_2025,
			            NOT ISBLANK(Fact_Flota_2025[AÑO_FAB]) &&
			            Fact_Flota_2025[AÑO_FAB] >= 1900 &&
			            Fact_Flota_2025[AÑO_FAB] <=
			                YEAR(Fact_Flota_2025[FECHA_CORTE]) &&
			            YEAR(Fact_Flota_2025[FECHA_CORTE]) -
			                Fact_Flota_2025[AÑO_FAB] >= 0 &&
			            YEAR(Fact_Flota_2025[FECHA_CORTE]) -
			                Fact_Flota_2025[AÑO_FAB] <= 10
			        )
			    )
			RETURN
			    DIVIDE(VehiculosMenor10, VehiculosConAnioValido)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 8482c584-1074-426b-ae84-5bbe14b8e6e6

	measure '% Flota mayor de 15 años' =
			
			VAR VehiculosConAnioValido =
			    CALCULATE(
			        [Vehículos únicos],
			        FILTER(
			            Fact_Flota_2025,
			            NOT ISBLANK(Fact_Flota_2025[AÑO_FAB]) &&
			            Fact_Flota_2025[AÑO_FAB] >= 1900 &&
			            Fact_Flota_2025[AÑO_FAB] <=
			                YEAR(Fact_Flota_2025[FECHA_CORTE])
			        )
			    )
			VAR VehiculosMayor15 =
			    CALCULATE(
			        [Vehículos únicos],
			        FILTER(
			            Fact_Flota_2025,
			            NOT ISBLANK(Fact_Flota_2025[AÑO_FAB]) &&
			            Fact_Flota_2025[AÑO_FAB] >= 1900 &&
			            Fact_Flota_2025[AÑO_FAB] <=
			                YEAR(Fact_Flota_2025[FECHA_CORTE]) &&
			            YEAR(Fact_Flota_2025[FECHA_CORTE]) -
			                Fact_Flota_2025[AÑO_FAB] > 15
			        )
			    )
			RETURN
			    DIVIDE(VehiculosMayor15, VehiculosConAnioValido)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: defe84ff-7db3-4e83-868f-5f0283f43a48

	measure '% Vehículos diésel' =
			
			VAR VehiculosDiesel =
			    CALCULATE(
			        [Vehículos únicos],
			        FILTER(
			            Fact_Flota_2025,
			            VAR TipoCombustible =
			                UPPER(
			                    TRIM(
			                        COALESCE(
			                            Fact_Flota_2025[Combustible],
			                            ""
			                        )
			                    )
			                )
			            RETURN
			                CONTAINSSTRING(TipoCombustible, "DIESEL") ||
			                CONTAINSSTRING(TipoCombustible, "DIÉSEL")
			        )
			    )
			RETURN
			    DIVIDE(
			        VehiculosDiesel,
			        [Vehículos únicos]
			    )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 6f607bc3-b055-4acf-a160-e6905c102ffe

	measure '% de vehículos por clase' =
			
			DIVIDE(
			    [Vehículos únicos],
			    CALCULATE(
			        [Vehículos únicos],
			        ALLSELECTED(Fact_Flota_2025[Clase de vehículo agrupada])
			    )
			)
		lineageTag: e375b77e-458a-475e-8d28-e399dc2088c3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cantidad y porcentaje de clase' =
			
			FORMAT([Vehículos únicos], "#,0", "en-US")
			    & " ("
			    & FORMAT([% de vehículos por clase], "0.0%", "en-US")
			    & ")"
		lineageTag: 134e898a-9019-4c13-be4b-869e45b99311

	measure 'Detalle Camión' =
			
			VAR TotalVisible = [Vehículos únicos]
			VAR Cantidad =
			    CALCULATE(
			        [Vehículos únicos],
			        KEEPFILTERS(
			            Fact_Flota_2025[Clase de vehículo agrupada] = "Camión"
			        )
			    )
			RETURN
			    IF(
			        NOT ISBLANK(Cantidad),
			        FORMAT(Cantidad, "#,0", "en-US")
			            & " ("
			            & FORMAT(DIVIDE(Cantidad, TotalVisible), "0.0%", "en-US")
			            & ")"
			    )
		lineageTag: 4800b06a-2053-4d4d-a053-3cfdecbcea46

	measure 'Detalle Semirremolque' =
			
