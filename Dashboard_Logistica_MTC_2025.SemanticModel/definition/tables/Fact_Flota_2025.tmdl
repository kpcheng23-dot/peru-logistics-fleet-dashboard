	measure '% combustible dentro de clase' =
			
			DIVIDE(
			    [Vehículos únicos],
			    CALCULATE(
			        [Vehículos únicos],
			        REMOVEFILTERS(Fact_Flota_2025[Combustible (grupos)])
			    )
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: e270d43f-e02d-4b34-9c36-9cbe1eca0d6a

	measure 'Años de fabricación válidos' =
			
			CALCULATE(
			    [Vehículos únicos],
			    FILTER(
			        Fact_Flota_2025,
			        NOT ISBLANK(Fact_Flota_2025[AÑO_FAB]) &&
			        NOT ISBLANK(Fact_Flota_2025[FECHA_CORTE]) &&
			        Fact_Flota_2025[AÑO_FAB] >= 1900 &&
			        Fact_Flota_2025[AÑO_FAB] <= YEAR(Fact_Flota_2025[FECHA_CORTE])
			    )
			)
		formatString: #,0
		lineageTag: 766c0a1c-1702-4de8-a2a7-e362e5e8eeec

